\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The feasible region $ R $ consists of those $ x $ satisfying $ A_i x \geq b_i $ for all $ i $. The normal vectors $ A_i $ point ``into'' $ R $, even for $ A_6 $. The constraints $ A_1 x \geq b_1 $ and $ A_2 x \geq b_2$ are active at $ x^*$, and the other constraints are inactive.}}{3}{figure.2}}
\newlabel{poly}{{2}{3}{The feasible region $ R $ consists of those $ x $ satisfying $ A_i x \geq b_i $ for all $ i $. The normal vectors $ A_i $ point ``into'' $ R $, even for $ A_6 $. The constraints $ A_1 x \geq b_1 $ and $ A_2 x \geq b_2$ are active at $ x^*$, and the other constraints are inactive}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\tocsection {}{3}{\textbf  {Farkas' Lemma}}}{3}{section.3}}
\newlabel{grav}{{3.1}{3}{\textbf {Farkas' Lemma}\relax }{theorem.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces In both cases the hypotheses of Farkas' lemma are satisfied. Note that in the second figure $ c \not \in \mathcal  {C} $ when the base of $ c $ is placed at $ x^* $.}}{4}{figure.3}}
\newlabel{cone}{{3}{4}{In both cases the hypotheses of Farkas' lemma are satisfied. Note that in the second figure $ c \not \in \mathcal {C} $ when the base of $ c $ is placed at $ x^* $}{figure.3}{}}
\newlabel{rmkdual}{{3.2}{4}{\textbf {Farkas' Lemma}\relax }{theorem.3.2}{}}
