\newlabel{figdual}{{4}{4}{A cone $ C $ and its dual $ C^* $. Note $ C^{**} = C $}{figure.4}{}}
\newlabel{ThmFar}{{3.3}{4}{\textbf {Farkas' Lemma}\relax }{theorem.3.3}{}}
