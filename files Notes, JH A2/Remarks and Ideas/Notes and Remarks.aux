\@ifundefined{amsrefs@bibcite}{}{\let\bibcite\amsrefs@bibcite}
\bibstyle{amsra}
\@writefile{toc}{\contentsline {section}{\tocsection {}{1}{\textbf  {13/5/09: Generation Process for $ V $-Variable Fractals}}}{1}{section.1}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{1.1}{Backward Process as Cell Division}}{1}{figure.2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \small  \textbf  {Backward Process.} The transformations rules are interpreted as {\relax \pdfsavepos \immediate \write \PDFPOS {l 62 99}\edef {p 61 0 0}{{p 62 5917979 18513213}}\write \PDFPOS {p 61 0 0}\global \advance \PDFSYNC@rder by 1\relax }\emph  {replacement/division} rules. \newline  \unhbox \voidb@x \hbox {} \hskip 1em\relax The bottom line shows the four possible types for the initial cell. The division rules at time 1 are shown next and are followed by the 4 resulting organisms at time 1. The transformation rules at time 2 are then followed by the resulting organisms at time 2. Finally, the transformation rules at time 3 are followed by the resulting organisms at time 3. \newline  \unhbox \voidb@x \hbox {} \hskip 1em\relax Now observe any of the four growing organisms at successive times and ignore the cell type, i.e.\ colour. The organism structure at each time is a refinement of the organism at the previous time. This is more easily seen in Figure\nonbreakingspace \ref  {V-vargenblack}, where colours are suppressed and the development beginning from the green cell is shown.}}{2}{figure.1}}
\newlabel{V-vargenA}{{1}{2}{\small \textbf {Backward Process.} The transformations rules are interpreted as \emph {replacement/division} rules. \newline \mbox {} \quad The bottom line shows the four possible types for the initial cell. The division rules at time 1 are shown next and are followed by the 4 resulting organisms at time 1. The transformation rules at time 2 are then followed by the resulting organisms at time 2. Finally, the transformation rules at time 3 are followed by the resulting organisms at time 3. \newline \mbox {} \quad Now observe any of the four growing organisms at successive times and ignore the cell type, i.e.\ colour. The organism structure at each time is a refinement of the organism at the previous time. This is more easily seen in Figure~\ref {V-vargenblack}, where colours are suppressed and the development beginning from the green cell is shown}{figure.1}{}}
\newlabel{fpob}{{1.2}{2}{Forward Process as Organisms Breeding\relax }{subsection.1.2}{}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{1.2}{Forward Process as Organisms Breeding}}{2}{figure.3}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \small  Organism development via cell division. Note how each embryo is a refinement of the embryo at the previous time.}}{3}{figure.2}}
\newlabel{V-vargenblack}{{2}{3}{\small Organism development via cell division. Note how each embryo is a refinement of the embryo at the previous time}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \small  \textbf  {Forward Process.} The transformations rules are interpreted as {\relax \pdfsavepos \immediate \write \PDFPOS {l 130 141}\edef {p 129 0 0}{{p 130 5917979 14377266}}\write \PDFPOS {p 129 0 0}\global \advance \PDFSYNC@rder by 1\relax }\emph  {combination} rules. \newline  \unhbox \voidb@x \hbox {} \hskip 1em\relax Begin with one individual organism of each type, ignoring any fine detail. The first set of combination rules produce 4 new organisms, one of each type. The second set produces another 4 and the third set produces another 4. After a few initial iterations, successive iterations produce a collection of organisms, 4 for each iteration, whose empirical distribution converges to the theoretical distribution of $ V $-variable fractals.}}{3}{figure.3}}
\newlabel{V-vargenB}{{3}{3}{\small \textbf {Forward Process.} The transformations rules are interpreted as \emph {combination} rules. \newline \mbox {} \quad Begin with one individual organism of each type, ignoring any fine detail. The first set of combination rules produce 4 new organisms, one of each type. The second set produces another 4 and the third set produces another 4. After a few initial iterations, successive iterations produce a collection of organisms, 4 for each iteration, whose empirical distribution converges to the theoretical distribution of $ V $-variable fractals}{figure.3}{}}
