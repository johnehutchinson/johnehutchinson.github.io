\@writefile{toc}{\contentsline {section}{\tocsection {}{2}{Convergent Process for Generating $ V $-Variable Fractals}}{2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Convergent Process.} Organism growth from initial cells. Transformations rules interpreted as \emph  {replacement/division} rules.}}{3}}
\newlabel{bp}{{1}{3}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Convergent Process.} Embryo/Organism growth from an initial green cell only. Same rules as in Figure\nonbreakingspace 1\hbox {}. Shown in the left column, from the bottom up, are $ \boldsymbol  {K^0}_2 $, \hskip 2em\relax $\boldsymbol  {K^1}_2 = {\setbox \z@ \hbox {\frozen@everymath \@emptytoks \mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ } \boldsymbol  {\Phi }^{a_1} ( \boldsymbol  {K^0}){\setbox \z@ \hbox {\frozen@everymath \@emptytoks \mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }_2 $, \hskip 2em\relax $\boldsymbol  {K^2}_2 = {\setbox \z@ \hbox {\frozen@everymath \@emptytoks \mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }\boldsymbol  {\Phi }^{a_1}\circ \boldsymbol  {\Phi }^{a_2} ( \boldsymbol  {K^0}){\setbox \z@ \hbox {\frozen@everymath \@emptytoks \mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }_2 $, $\boldsymbol  {K^3}_2 = {\setbox \z@ \hbox {\frozen@everymath \@emptytoks \mathsurround \z@ $\nulldelimiterspace \z@ \left (\vcenter to\@ne \big@size {}\right .$}\box \z@ }\boldsymbol  {\Phi }^{a_1} \circ \boldsymbol  {\Phi }^{a_2}\circ \boldsymbol  {\Phi }^{a_3} ( \boldsymbol  {K^0}){\setbox \z@ \hbox {\frozen@everymath \@emptytoks \mathsurround \z@ $\nulldelimiterspace \z@ \left )\vcenter to\@ne \big@size {}\right .$}\box \z@ }_2 $. \hskip 1em\relax Alternatively, the analogous tree growth from an initial green limb, with 4 types of limbs in general and associated branching determined by the $\boldsymbol  {\Phi }^{a} $, is also shown. Note that the tree diagram encodes the complete construction information, unlike the embryo diagram. The top tree here is the bottom tree in Figure\nonbreakingspace 4\hbox {}. }}{4}}
\newlabel{bp1}{{2}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Organism development via cell division. Each embryo is a refinement of the embryo at the previous time. Same as growth from green cell, with colours suppressed here. \vspace  {1cm}}}{5}}
\newlabel{V-vargenblack}{{3}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The dots at the top show the colours representing the 4 components. The top row of trees is $ \boldsymbol  {\Phi }^{a_3} ( \boldsymbol  {K^0}) $. The next row is $ \boldsymbol  {\Phi }^{a_2}\circ \boldsymbol  {\Phi }^{a_3} ( \boldsymbol  {K^0}) $. The bottom row is $ \boldsymbol  {\Phi }^{a_1} \circ \boldsymbol  {\Phi }^{a_2}\circ \boldsymbol  {\Phi }^{a_3} ( \boldsymbol  {K^0}) $, with just the second component showing. Compare with Figure\nonbreakingspace 2\hbox {}, which gives bottom up tree growth, whereas here we have top down tree development/description.}}{5}}
\newlabel{treeg}{{4}{5}}
\@writefile{toc}{\contentsline {section}{\tocsection {}{3}{Convergent Process for Generating $ V $-Variable Trees}}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tree growth. Each limb is one of $ V=4 $ types. The transformation rules at each stage determine how a particular type of limb grows. Here we begin with a single green type limb. The rules here are the same as in Figure\nonbreakingspace 1\hbox {}.}}{6}}
\newlabel{treegr}{{5}{6}}
